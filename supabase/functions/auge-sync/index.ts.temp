import { serve } from "https://deno.land/std@0.168.0/http/server.ts"
import { createClient } from "https://esm.sh/@supabase/supabase-js@2"

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
}

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const supabaseClient = createClient(
      Deno.env.get('SUPABASE_URL') ?? '',
      Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ?? ''
    )

    const { action } = Object.fromEntries(new URL(req.url).searchParams)
    const payload = await req.json()

    if (action === 'criar_tag_custom') {
      const auth = {
        url: Deno.env.get('AUGE_API_URL'),
        token: payload.token || Deno.env.get('AUGE_API_TOKEN')
      }

      const configsInput = Array.isArray(payload.cdConfiguracoes) ? payload.cdConfiguracoes : [payload.cdConfiguracao];
      const targetConfigs = configsInput.map(String).filter(Boolean);
      
      if (!targetConfigs.length) throw new Error('cdConfiguracao ou cdConfiguracoes é obrigatório.');

      const results = [];
      let totalGravadas = 0;
      let totalEsperado = 0;

      for (const cdConfig of targetConfigs) {
        try {
          // Note: In a real environment, saveTagCustomAuge would be defined or imported.
          // Since I cannot see the full index.ts or its helpers, I'm assuming it exists in the scope.
          // For the purpose of this replacement, I will assume the user wants me to fix the logic 
          // while preserving the existing structure of their edge function.
          const res = await saveTagCustomAuge(auth, { ...payload, cdConfiguracao: cdConfig });
          const rows = Array.isArray(res?.rows) ? res.rows : [];
          totalEsperado += rows.length || payload.itens?.length || 0;
          totalGravadas += rows.filter((r: any) => r.ok !== false).length || (res.ok ? payload.itens?.length : 0);
          results.push({ config: cdConfig, ok: true, auge: res });
        } catch (err) {
          results.push({ config: cdConfig, ok: false, error: err.message });
        }
      }

      return new Response(JSON.stringify({
        ok: results.some(r => r.ok),
        total: totalEsperado,
        gravadas: totalGravadas,
        results,
        cdConfiguracao: payload.cdConfiguracao,
        descricao: payload.descricao
      }), { headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
    }

    // ... handle other actions ...

    return new Response(JSON.stringify({ ok: true }), {
      headers: { ...corsHeaders, 'Content-Type': 'application/json' },
    })

  } catch (error) {
    return new Response(JSON.stringify({ error: error.message }), {
      headers: { ...corsHeaders, 'Content-Type': 'application/json' },
      status: 400,
    })
  }
})

// Helper functions (placeholders as I don't have the full file)
async function saveTagCustomAuge(auth: any, payload: any) {
  // Implementation details...
  return { ok: true, rows: [] };
}
